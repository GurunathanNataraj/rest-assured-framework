<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="API Smoke Suite" parallel="methods" thread-count="2">
    <test name="User API Smoke Tests">
        <groups>
            <run>
                <include name="smoke"/>
            </run>
        </groups>
        <classes>
            <class name="com.api.automation.UserAPITest"/>
        </classes>
    </test>
</suite>
